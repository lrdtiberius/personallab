FROM node:24-alpine

WORKDIR /app
COPY local-api/ /app/

ENV NODE_ENV=production \
    PORT=8095 \
    DATA_FILE=/data/personallab.json

RUN addgroup -S personallab && adduser -S -G personallab -u 10001 personallab \
    && mkdir -p /data && chown -R personallab:personallab /app /data

USER 10001:10001
EXPOSE 8095
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1:8095/api/health >/dev/null || exit 1
CMD ["node", "/app/server.mjs"]
