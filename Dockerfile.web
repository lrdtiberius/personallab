FROM node:24-alpine AS build
RUN apk add --no-cache bash coreutils
WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/ ./scripts/
RUN npm ci
COPY . .
RUN chmod +x scripts/*.sh && npm run build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    PERSONALLAB_API_URL=http://personal-lab-api:8095
COPY --from=build /app /app
RUN addgroup -S personallab && adduser -S -G personallab -u 10001 personallab \
    && chown -R personallab:personallab /app
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
