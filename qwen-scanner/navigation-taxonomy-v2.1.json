{
  "version": "navigation-taxonomy-v2.1",
  "purpose": "Objekt- und Vertragsinstanz-basierte Ablage statt pauschaler Jahresordner",
  "coreRules": [
    {
      "id": "year-folders-only-for-recurring-documents",
      "rule": "Jahresordner dürfen nur für wiederkehrende Serienbelege verwendet werden.",
      "examples": [
        "Kontoauszüge",
        "Gehaltsabrechnungen",
        "monatliche Rechnungen",
        "Beitragsrechnungen",
        "Jahresabrechnungen",
        "Steuerbescheinigungen",
        "Verbrauchsabrechnungen"
      ]
    },
    {
      "id": "no-year-folders-for-contract-instances",
      "rule": "Verträge, Vertragsänderungen, Kündigungen, Kredite, Fahrzeugakten, Mobilfunkverträge und Versicherungsverträge dürfen nicht primär nach Jahr abgelegt werden. Sie gehören unter die passende Vertragsinstanz oder das passende Objekt."
    },
    {
      "id": "contract-instance-first",
      "rule": "Wenn ein Dokument eine konkrete Vertragsnummer, Kundennummer, Rufnummer, IBAN, Zählernummer, Versicherungsnummer, FIN, Fahrzeugbezeichnung oder Kreditreferenz enthält, muss zuerst diese Instanz als Ablageziel bevorzugt werden."
    },
    {
      "id": "series-documents-under-instance-year",
      "rule": "Serienbelege werden unter der passenden Instanz abgelegt und dort optional nach Jahr gruppiert."
    }
  ],
