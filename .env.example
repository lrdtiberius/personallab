TZ=Europe/Berlin
PERSONALLAB_BIND_ADDRESS=192.168.1.100
PERSONALLAB_HOST_PORT=8094

PAPERLESS_URL=http://192.168.1.100:8001
PAPERLESS_TOKEN=

# Digital-Akte-Analyzer 1.2.2; analysis results are merged by Paperless ID.
ANALYZER_URL=http://192.168.1.100:8093

HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# EnergyLab 0.4.5 instance; PersonalLab only reads from it.
ENERGYLAB_URL=http://192.168.1.100:8090
ENERGYLAB_USERNAME=
ENERGYLAB_PASSWORD=

FINANZLAB_URL=http://192.168.1.100:8798
FINANZLAB_HOUSEHOLD_ID=

AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=15
SYNC_ON_START=true
